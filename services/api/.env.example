# Same as EXPO_PUBLIC_SUPABASE_URL. Use http://127.0.0.1:54321 for local `supabase start`.
SUPABASE_URL=

# From `supabase status` — the "Secret" / service_role key. Bypasses RLS; server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# From `supabase status` — the legacy "JWT secret". Used to verify HS256-signed JWTs; newer
# projects issue ES256/RS256-signed JWTs instead, verified via the project's JWKS endpoint
# (see src/plugins/auth.ts), so this is a fallback rather than the only verification path.
SUPABASE_JWT_SECRET=

# memory | redis. Local and production use redis so the API, worker, and runner share
# lineups. memory is only for tests (NODE_ENV=test).
CACHE_DRIVER=redis

# ioredis URL for the API, worker, and runner. Local Docker: redis://127.0.0.1:6379.
# Production: Upstash's TCP URL (rediss://…). Game state, the lineup cache, the flag
# queue, and pub/sub use this client. The REST variables below are only the fallback
# when REDIS_URL is unset.
REDIS_URL=redis://127.0.0.1:6379

# Fallback when REDIS_URL is unset and CACHE_DRIVER=redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback TCP URL for `/v1/realtime` when REDIS_URL is unset. The REST client cannot hold
# a `(P)SUBSCRIBE`.
UPSTASH_REDIS_TCP_URL=

# Authorization header value RevenueCat sends to POST /billing/revenuecat (optional until billing).
REVENUECAT_WEBHOOK_SECRET=

# none | expo. Unset boots as none (log, no network). expo constructs ExpoPushNotifier even
# when EXPO_ACCESS_TOKEN is unset.
# PUSH_DRIVER=none
# EXPO_ACCESS_TOKEN=

PORT=3000
