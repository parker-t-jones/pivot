# Same as EXPO_PUBLIC_SUPABASE_URL. Use http://127.0.0.1:54321 for local `supabase start`.
SUPABASE_URL=

# From `supabase status` — the "Secret" / service_role key. Bypasses RLS; server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# From `supabase status` — the legacy "JWT secret". Used to verify HS256-signed JWTs; newer
# projects issue ES256/RS256-signed JWTs instead, verified via the project's JWKS endpoint
# (see src/plugins/auth.ts), so this is a fallback rather than the only verification path.
SUPABASE_JWT_SECRET=

# memory | redis. Use memory for local dev/tests; flip to redis once Upstash is provisioned
# (Sprint 4) — see src/cache/.
CACHE_DRIVER=memory

# Required only when CACHE_DRIVER=redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required only when CACHE_DRIVER=redis. The `rediss://` TCP connection string (Upstash dashboard) —
# needed by the `/v1/realtime` fan-out subscriber, which requires a persistent connection the REST
# client above can't provide (Sprint 5 Phase 4).
UPSTASH_REDIS_TCP_URL=

PORT=3000
