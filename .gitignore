# Expo-generated native projects only. Anchored: a bare `android`/`ios` also matched
# `app/modules/*/ios`, silently excluding local native module source that must be committed.
/app/android/
/app/ios/
# Local one-off harnesses and seed workarounds. Promote to experiments/ or scripts/ under a real
# name if one earns a permanent place; the tmp- prefix means "safe to delete".
/scripts/tmp-*.ts
# `pnpm update:ios` export. Ignored so `eas update` sees a clean tree.
/app/dist-update/

