{
  "expo": {
    "name": "Pivot",
    "slug": "fantasy-focus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pivot",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fantasyfocus.app",
      "associatedDomains": ["webcredentials:app.pivot-sports.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["sportscenter"]
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Confirm it's you before changing your password."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63e2ba9a-dc24-48cc-af2b-dc2c27014634"
      }
    },
    "owner": "parkertjones"
  }
}
