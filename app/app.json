{
  "expo": {
    "name": "Pivot",
    "slug": "fantasy-focus",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pivot",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fantasyfocus.app",
      "associatedDomains": ["webcredentials:app.pivot-sports.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["sportscenter"]
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Confirm it's you before changing your password."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pivot reads the bet slip screenshot you choose so you can add its picks.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63e2ba9a-dc24-48cc-af2b-dc2c27014634"
      }
    },
    "owner": "parkertjones",
    "updates": {
      "url": "https://u.expo.dev/63e2ba9a-dc24-48cc-af2b-dc2c27014634",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
