# Local Supabase (`supabase start`). On a physical device this must be an address the phone can
# reach — Mac Wi-Fi IP (ipconfig getifaddr en0) or, if USB-only and Wi-Fi times out, the Mac USB
# link-local IP (ifconfig en8). Never 127.0.0.1/localhost. Restart Metro after changing.
# See RUNBOOK.md "PHYSICAL DEVICE (iOS)".
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# services/api's `PORT` (default 3000). Same host rule as Supabase above.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# RevenueCat public iOS SDK key (optional until Pro IAP is wired). Without it, Upgrade UI still
# opens; purchase/restore require a key + native rebuild.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Public VAPID key for this browser. Copy it from services/api/.env.local into app/.env.local
# (gitignored) as EXPO_PUBLIC_VAPID_PUBLIC_KEY. Never put the private key here. Restart Metro
# after changing. Production sets this as a Pages build variable.
# EXPO_PUBLIC_VAPID_PUBLIC_KEY=
