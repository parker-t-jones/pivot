EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# services/api's `PORT` (default 3000). On a physical device this must be your Mac's LAN IP
# (e.g. http://192.168.1.23:3000), not 127.0.0.1/localhost — the device can't reach your Mac's loopback.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
